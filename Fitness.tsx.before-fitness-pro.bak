import { useCallback, useEffect, useMemo, useState, type FormEvent, type ReactNode } from 'react'
import {
  Activity, CalendarDays, ChartNoAxesCombined, Dumbbell,
  Footprints, Plus, Scale, Target, Trash2, TrendingUp
} from 'lucide-react'
import { db, getTodayKey, type StoredMeasurement, type StoredRun, type StoredWorkout } from '../../database/db'
import { exerciseLibrary } from './data'

type Section = 'workouts' | 'running' | 'body'

const inputClass = 'w-full rounded-xl border border-white/10 bg-[#0c100d] px-3 py-3 text-sm text-zinc-100 outline-none transition focus:border-emerald-400/50'
const labelClass = 'mb-1.5 block text-xs font-medium text-zinc-400'
const cardClass = 'rounded-2xl border border-white/[0.07] bg-[#111412] p-5'

function dateLabel(date: string) {
  return new Date(`${date}T12:00:00`).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })
}

function Fitness() {
  const [section, setSection] = useState<Section>('workouts')
  const [workouts, setWorkouts] = useState<StoredWorkout[]>([])
  const [runs, setRuns] = useState<StoredRun[]>([])
  const [measurements, setMeasurements] = useState<StoredMeasurement[]>([])
  const [targetWeight, setTargetWeight] = useState('70')
  const [gymTarget, setGymTarget] = useState('4')
  const [runTarget, setRunTarget] = useState('3')
  const [workoutName, setWorkoutName] = useState('Gym session')
  const [exerciseId, setExerciseId] = useState(exerciseLibrary[0].id)
  const [sets, setSets] = useState('3')
  const [reps, setReps] = useState('12')
  const [weight, setWeight] = useState('0')
  const [duration, setDuration] = useState('60')
  const [workoutNotes, setWorkoutNotes] = useState('')
  const [distance, setDistance] = useState('')
  const [runDuration, setRunDuration] = useState('')
  const [runNotes, setRunNotes] = useState('')
  const [measurementDate, setMeasurementDate] = useState(getTodayKey())
  const [weightKg, setWeightKg] = useState('')
  const [waist, setWaist] = useState('')
  const [chest, setChest] = useState('')
  const [arm, setArm] = useState('')
  const [hip, setHip] = useState('')
  const [measurementNotes, setMeasurementNotes] = useState('')
  const [saving, setSaving] = useState(false)

  const refresh = useCallback(async () => {
    const [w, r, m, goal] = await Promise.all([
      db.workouts.orderBy('date').reverse().toArray(),
      db.runs.orderBy('date').reverse().toArray(),
      db.measurements.orderBy('date').reverse().toArray(),
      db.fitnessGoals.get('main'),
    ])
    setWorkouts(w)
    setRuns(r)
    setMeasurements(m)
    if (goal) {
      setTargetWeight(String(goal.targetWeightKg))
      setGymTarget(String(goal.weeklyGymSessions))
      setRunTarget(String(goal.weeklyRunningSessions))
    }
  }, [])

  useEffect(() => { void refresh() }, [refresh])

  const latestWeight = measurements[0]?.weightKg
  const firstWeight = measurements.length ? measurements[measurements.length - 1].weightKg : undefined
  const weightChange = latestWeight !== undefined && firstWeight !== undefined ? latestWeight - firstWeight : 0
  const weeklyWorkouts = useMemo(() => {
    const cutoff = new Date()
    cutoff.setDate(cutoff.getDate() - 6)
    const from = `${cutoff.getFullYear()}-${String(cutoff.getMonth() + 1).padStart(2, '0')}-${String(cutoff.getDate()).padStart(2, '0')}`
    return workouts.filter(item => item.date >= from).length
  }, [workouts])
  const weeklyRuns = useMemo(() => {
    const cutoff = new Date()
    cutoff.setDate(cutoff.getDate() - 6)
    const from = `${cutoff.getFullYear()}-${String(cutoff.getMonth() + 1).padStart(2, '0')}-${String(cutoff.getDate()).padStart(2, '0')}`
    return runs.filter(item => item.date >= from).length
  }, [runs])
  const totalKm = runs.reduce((sum, run) => sum + run.distanceKm, 0)

  async function saveWorkout(event: FormEvent<HTMLFormElement>) {
    event.preventDefault()
    const exercise = exerciseLibrary.find(item => item.id === exerciseId)
    if (!exercise) return
    setSaving(true)
    try {
      await db.workouts.add({
        id: crypto.randomUUID(),
        date: getTodayKey(),
        workoutName: workoutName.trim() || 'Gym session',
        durationMinutes: Number(duration),
        exerciseName: exercise.name,
        muscleGroup: exercise.muscleGroup,
        sets: Array.from({ length: Math.max(1, Math.min(10, Number(sets) || 1)) }, (_, index) => ({
          setNumber: index + 1,
          reps: Math.max(0, Number(reps) || 0),
          weightKg: Math.max(0, Number(weight) || 0),
        })),
        notes: workoutNotes.trim() || undefined,
      })
      setWorkoutNotes('')
      await refresh()
    } finally { setSaving(false) }
  }

  async function saveRun(event: FormEvent<HTMLFormElement>) {
    event.preventDefault()
    if (Number(distance) <= 0 || Number(runDuration) <= 0) return
    setSaving(true)
    try {
      await db.runs.add({
        id: crypto.randomUUID(),
        date: getTodayKey(),
        distanceKm: Number(distance),
        durationMinutes: Number(runDuration),
        notes: runNotes.trim() || undefined,
      })
      setDistance('')
      setRunDuration('')
      setRunNotes('')
      await refresh()
    } finally { setSaving(false) }
  }

  async function saveMeasurement(event: FormEvent<HTMLFormElement>) {
    event.preventDefault()
    if (Number(weightKg) <= 0) return
    setSaving(true)
    try {
      await db.measurements.add({
        id: crypto.randomUUID(),
        date: measurementDate,
        weightKg: Number(weightKg),
        waistCm: waist ? Number(waist) : undefined,
        chestCm: chest ? Number(chest) : undefined,
        armCm: arm ? Number(arm) : undefined,
        hipCm: hip ? Number(hip) : undefined,
        notes: measurementNotes.trim() || undefined,
      })
      setWaist(''); setChest(''); setArm(''); setHip(''); setMeasurementNotes('')
      await refresh()
    } finally { setSaving(false) }
  }

  async function saveGoals(event: FormEvent<HTMLFormElement>) {
    event.preventDefault()
    await db.fitnessGoals.put({
      id: 'main',
      targetWeightKg: Number(targetWeight) || 0,
      weeklyGymSessions: Number(gymTarget) || 0,
      weeklyRunningSessions: Number(runTarget) || 0,
    })
    await refresh()
  }

  async function deleteWorkout(id: string) { await db.workouts.delete(id); await refresh() }
  async function deleteRun(id: string) { await db.runs.delete(id); await refresh() }
  async function deleteMeasurement(id: string) { await db.measurements.delete(id); await refresh() }

  const selectedExercise = exerciseLibrary.find(item => item.id === exerciseId)

  return (
    <div className="space-y-6">
      <header className="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <div className="mb-2 flex items-center gap-2 text-sm font-medium text-emerald-400"><Activity size={17} /> FITNESS WORKSPACE</div>
          <h2 className="text-3xl font-bold tracking-tight">Train with purpose.</h2>
          <p className="mt-2 text-sm text-zinc-500">One place for strength, running and body-composition progress.</p>
        </div>
        <div className="flex items-center gap-2 text-xs text-zinc-500"><CalendarDays size={15} /> {new Date().toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long' })}</div>
      </header>

      <section className="grid grid-cols-2 gap-3 xl:grid-cols-4">
        <Metric icon={Dumbbell} label="Gym sessions Â· 7 days" value={String(weeklyWorkouts)} detail={`Target: ${gymTarget || 0}/week`} />
        <Metric icon={Footprints} label="Runs Â· 7 days" value={String(weeklyRuns)} detail={`Target: ${runTarget || 0}/week`} />
        <Metric icon={Activity} label="Total distance" value={`${totalKm.toFixed(1)} km`} detail={`${runs.length} run records`} />
        <Metric icon={Scale} label="Latest weight" value={latestWeight ? `${latestWeight.toFixed(1)} kg` : 'â€”'} detail={latestWeight ? `${weightChange > 0 ? '+' : ''}${weightChange.toFixed(1)} kg since first log` : 'Add your first measurement'} />
      </section>

      <section className="grid gap-5 xl:grid-cols-[1.5fr_1fr]">
        <div className={cardClass}>
          <div className="mb-5 flex flex-wrap items-center justify-between gap-3">
            <div><h3 className="font-semibold">Fitness tracker</h3><p className="mt-1 text-xs text-zinc-500">Log activity and keep your records in one place.</p></div>
            <div className="flex rounded-xl bg-[#0b0e0c] p-1">
              {([{ id: 'workouts', label: 'Workout' }, { id: 'running', label: 'Running' }, { id: 'body', label: 'Body' }] as const).map(item => (
                <button key={item.id} onClick={() => setSection(item.id)} className={`rounded-lg px-3 py-2 text-xs font-medium ${section === item.id ? 'bg-emerald-400 text-black' : 'text-zinc-500 hover:text-white'}`}>{item.label}</button>
              ))}
            </div>
          </div>

          {section === 'workouts' && (
            <form onSubmit={saveWorkout} className="grid gap-4 sm:grid-cols-2">
              <Field label="Workout name"><input className={inputClass} value={workoutName} onChange={e => setWorkoutName(e.target.value)} placeholder="Push day, Pull day..." /></Field>
              <Field label="Exercise"><select className={inputClass} value={exerciseId} onChange={e => setExerciseId(e.target.value)}>{exerciseLibrary.map(item => <option key={item.id} value={item.id}>{item.name} Â· {item.muscleGroup}</option>)}</select></Field>
              <Field label="Sets"><input className={inputClass} type="number" min="1" max="10" value={sets} onChange={e => setSets(e.target.value)} /></Field>
              <Field label="Reps per set"><input className={inputClass} type="number" min="0" value={reps} onChange={e => setReps(e.target.value)} /></Field>
              <Field label="Weight (kg)"><input className={inputClass} type="number" min="0" step="0.5" value={weight} onChange={e => setWeight(e.target.value)} /></Field>
              <Field label="Session duration (minutes)"><input className={inputClass} type="number" min="1" value={duration} onChange={e => setDuration(e.target.value)} /></Field>
              <div className="sm:col-span-2"><Field label="Notes (optional)"><input className={inputClass} value={workoutNotes} onChange={e => setWorkoutNotes(e.target.value)} placeholder="How did the session feel?" /></Field></div>
              <div className="flex items-center justify-between gap-3 sm:col-span-2"><p className="text-xs text-zinc-500">{selectedExercise?.equipment} Â· {selectedExercise?.muscleGroup}</p><button disabled={saving} className="inline-flex items-center gap-2 rounded-xl bg-emerald-400 px-5 py-3 text-sm font-semibold text-black disabled:opacity-50"><Plus size={16} /> Save workout</button></div>
            </form>
          )}

          {section === 'running' && (
            <form onSubmit={saveRun} className="grid gap-4 sm:grid-cols-2">
              <Field label="Distance (km)"><input required className={inputClass} type="number" min="0.1" step="0.01" value={distance} onChange={e => setDistance(e.target.value)} placeholder="e.g. 3.5" /></Field>
              <Field label="Duration (minutes)"><input required className={inputClass} type="number" min="1" step="1" value={runDuration} onChange={e => setRunDuration(e.target.value)} placeholder="e.g. 30" /></Field>
              <div className="sm:col-span-2"><Field label="Notes (optional)"><input className={inputClass} value={runNotes} onChange={e => setRunNotes(e.target.value)} placeholder="Route, effort, conditions..." /></Field></div>
              {Number(distance) > 0 && Number(runDuration) > 0 && <div className="rounded-xl bg-[#0b0e0c] p-3 text-sm text-zinc-400 sm:col-span-2">Estimated pace: <strong className="text-emerald-400">{(Number(runDuration) / Number(distance)).toFixed(2)} min/km</strong></div>}
              <div className="sm:col-span-2 flex justify-end"><button disabled={saving} className="inline-flex items-center gap-2 rounded-xl bg-emerald-400 px-5 py-3 text-sm font-semibold text-black disabled:opacity-50"><Plus size={16} /> Save run</button></div>
            </form>
          )}

          {section === 'body' && (
            <form onSubmit={saveMeasurement} className="grid gap-4 sm:grid-cols-2">
              <Field label="Measurement date"><input required className={inputClass} type="date" value={measurementDate} onChange={e => setMeasurementDate(e.target.value)} /></Field>
              <Field label="Weight (kg)"><input required className={inputClass} type="number" min="1" step="0.1" value={weightKg} onChange={e => setWeightKg(e.target.value)} placeholder="e.g. 82.5" /></Field>
              <Field label="Waist (cm)"><input className={inputClass} type="number" min="1" step="0.1" value={waist} onChange={e => setWaist(e.target.value)} /></Field>
              <Field label="Chest (cm)"><input className={inputClass} type="number" min="1" step="0.1" value={chest} onChange={e => setChest(e.target.value)} /></Field>
              <Field label="Arm (cm)"><input className={inputClass} type="number" min="1" step="0.1" value={arm} onChange={e => setArm(e.target.value)} /></Field>
              <Field label="Hip (cm)"><input className={inputClass} type="number" min="1" step="0.1" value={hip} onChange={e => setHip(e.target.value)} /></Field>
              <div className="sm:col-span-2"><Field label="Notes (optional)"><input className={inputClass} value={measurementNotes} onChange={e => setMeasurementNotes(e.target.value)} /></Field></div>
              <div className="sm:col-span-2 flex justify-end"><button disabled={saving} className="inline-flex items-center gap-2 rounded-xl bg-emerald-400 px-5 py-3 text-sm font-semibold text-black disabled:opacity-50"><Plus size={16} /> Save measurements</button></div>
            </form>
          )}
        </div>

        <div className={cardClass}>
          <div className="mb-5 flex items-center gap-2"><Target className="text-emerald-400" size={19} /><h3 className="font-semibold">Fitness targets</h3></div>
          <form onSubmit={saveGoals} className="space-y-4">
            <Field label="Target weight (kg)"><input className={inputClass} type="number" min="1" step="0.1" value={targetWeight} onChange={e => setTargetWeight(e.target.value)} /></Field>
            <Field label="Gym sessions per week"><input className={inputClass} type="number" min="0" max="14" value={gymTarget} onChange={e => setGymTarget(e.target.value)} /></Field>
            <Field label="Running sessions per week"><input className={inputClass} type="number" min="0" max="14" value={runTarget} onChange={e => setRunTarget(e.target.value)} /></Field>
            <button className="w-full rounded-xl border border-emerald-400/20 bg-emerald-400/10 py-3 text-sm font-semibold text-emerald-400 hover:bg-emerald-400/15">Save targets</button>
          </form>
          <div className="mt-6 rounded-xl bg-[#0b0e0c] p-4">
            <div className="mb-2 flex items-center gap-2 text-xs text-zinc-500"><TrendingUp size={14} /> Weekly activity</div>
            <Progress label="Gym" value={weeklyWorkouts} target={Number(gymTarget)} />
            <Progress label="Running" value={weeklyRuns} target={Number(runTarget)} />
          </div>
        </div>
      </section>

      <section className="grid gap-5 xl:grid-cols-2">
        <History title="Workout history" icon={Dumbbell} empty="No workouts logged yet." count={workouts.length}>
          {workouts.slice(0, 8).map(item => <div key={item.id} className="flex items-start justify-between gap-3 border-b border-white/[0.06] py-3 last:border-0"><div className="min-w-0"><p className="text-sm font-medium">{item.workoutName} Â· {item.exerciseName}</p><p className="mt-1 text-xs text-zinc-500">{dateLabel(item.date)} Â· {item.sets.length} sets Ã— {item.sets[0]?.reps ?? 0} reps Â· {item.sets[0]?.weightKg ?? 0} kg Â· {item.durationMinutes} min</p></div><button onClick={() => void deleteWorkout(item.id)} aria-label="Delete workout" className="p-1 text-zinc-600 hover:text-red-400"><Trash2 size={15} /></button></div>)}
        </History>
        <History title="Running history" icon={Footprints} empty="No runs logged yet." count={runs.length}>
          {runs.slice(0, 8).map(item => <div key={item.id} className="flex items-start justify-between gap-3 border-b border-white/[0.06] py-3 last:border-0"><div><p className="text-sm font-medium">{item.distanceKm.toFixed(2)} km run</p><p className="mt-1 text-xs text-zinc-500">{dateLabel(item.date)} Â· {item.durationMinutes} min Â· {(item.durationMinutes / item.distanceKm).toFixed(2)} min/km</p></div><button onClick={() => void deleteRun(item.id)} aria-label="Delete run" className="p-1 text-zinc-600 hover:text-red-400"><Trash2 size={15} /></button></div>)}
        </History>
      </section>

      <section className={cardClass}>
        <div className="mb-4 flex items-center gap-2"><ChartNoAxesCombined size={19} className="text-emerald-400" /><h3 className="font-semibold">Body measurement history</h3></div>
        {measurements.length === 0 ? <p className="text-sm text-zinc-500">No measurements logged yet. Add your first entry above.</p> : (
          <div className="overflow-x-auto">
            <table className="w-full min-w-[520px] text-left text-sm">
              <thead className="text-xs text-zinc-500"><tr><th className="pb-3">Date</th><th className="pb-3">Weight</th><th className="pb-3">Waist</th><th className="pb-3">Chest</th><th className="pb-3">Arm</th><th className="pb-3"> </th></tr></thead>
              <tbody>{measurements.slice(0, 12).map(item => <tr key={item.id} className="border-t border-white/[0.06]"><td className="py-3">{dateLabel(item.date)}</td><td>{item.weightKg.toFixed(1)} kg</td><td>{item.waistCm ? `${item.waistCm} cm` : 'â€”'}</td><td>{item.chestCm ? `${item.chestCm} cm` : 'â€”'}</td><td>{item.armCm ? `${item.armCm} cm` : 'â€”'}</td><td className="text-right"><button onClick={() => void deleteMeasurement(item.id)} aria-label="Delete measurement" className="p-1 text-zinc-600 hover:text-red-400"><Trash2 size={15} /></button></td></tr>)}</tbody>
            </table>
          </div>
        )}
      </section>
      <p className="text-center text-[11px] text-zinc-600">Fitness records are stored locally in this browser on this device.</p>
    </div>
  )
}

function Field({ label, children }: { label: string; children: ReactNode }) {
  return <label className="block"><span className={labelClass}>{label}</span>{children}</label>
}

function Metric({ icon: Icon, label, value, detail }: { icon: typeof Activity; label: string; value: string; detail: string }) {
  return <div className={cardClass}><div className="mb-3 flex items-center justify-between"><span className="text-xs text-zinc-500">{label}</span><Icon size={18} className="text-emerald-400" /></div><p className="text-2xl font-bold">{value}</p><p className="mt-1 text-[11px] text-zinc-600">{detail}</p></div>
}


function Progress({ label, value, target }: { label: string; value: number; target: number }) {
  const percent = target > 0 ? Math.min(100, Math.round(value / target * 100)) : 0
  return <div className="mt-3"><div className="mb-1 flex justify-between text-xs"><span className="text-zinc-400">{label}</span><span className="text-zinc-500">{value}/{target}</span></div><div className="h-1.5 overflow-hidden rounded-full bg-zinc-800"><div className="h-full rounded-full bg-emerald-400" style={{ width: `${percent}%` }} /></div></div>
}

function History({ title, icon: Icon, empty, count, children }: { title: string; icon: typeof Activity; empty: string; count: number; children: ReactNode }) {
  return <div className={cardClass}><div className="mb-2 flex items-center justify-between"><div className="flex items-center gap-2"><Icon size={18} className="text-emerald-400" /><h3 className="font-semibold">{title}</h3></div><span className="text-xs text-zinc-600">{count} records</span></div>{count === 0 ? <p className="py-5 text-sm text-zinc-500">{empty}</p> : <div>{children}</div>}</div>
}

export default Fitness
