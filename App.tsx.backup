
import { useState } from 'react'
import { useDailyRecord } from './hooks/useDailyRecord'
import Fitness from './modules/fitness/Fitness'
import {
  Activity,
  ArrowUpRight,
  BookOpen,
  Brain,
  CalendarDays,
  Check,
  ChevronRight,
  Droplets,
  Dumbbell,
  Flame,
  GraduationCap,
  Heart,
  Home,
  Plus,
  Settings,
  Shield,
  Sparkles,
  Target,
  TrendingUp,
  Utensils,
  Zap,
} from 'lucide-react'

const habitsInitial = [
  { id: 1, name: 'Morning routine', detail: 'Walk, run & freshen up', done: false },
  { id: 2, name: 'Meditation', detail: '10 minutes of mindfulness', done: false },
  { id: 3, name: 'Major subject study', detail: 'Computer Science', done: false },
  { id: 4, name: 'Cybersecurity learning', detail: 'Hands-on practice', done: false },
  { id: 5, name: 'Reading', detail: '10 pages minimum', done: false },
]

const navigation = [
  { name: 'Overview', icon: Home },
  { name: 'Fitness', icon: Dumbbell },
  { name: 'Nutrition', icon: Utensils },
  { name: 'Habits', icon: Target },
  { name: 'Growth', icon: GraduationCap },
]

function App() {
  const [activeTab, setActiveTab] = useState('Overview')

const {
  water,
  completedHabitIds,
  loading,
  toggleHabit,
  addWater,
} = useDailyRecord()

const habits = habitsInitial.map((habit) => ({
  ...habit,
  done: completedHabitIds.includes(habit.id),
}))

  const completed = habits.filter((habit) => habit.done).length
  const progress = Math.round((completed / habits.length) * 100)
  const waterGoal = 3000
  const waterProgress = Math.min(100, Math.round((water / waterGoal) * 100))

  const today = new Intl.DateTimeFormat('en-IN', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
  }).format(new Date())

 

 
  if (loading) {
  return <div>Loading LifeOS...</div>
}
  return (
    <div className="min-h-screen bg-[#090b0a] text-zinc-100">
      <div className="mx-auto flex min-h-screen max-w-[1440px]">

        {/* Desktop sidebar */}
        <aside className="hidden w-64 shrink-0 border-r border-white/[0.06] px-6 py-8 md:flex md:flex-col">
          <div className="mb-12 flex items-center gap-3">
            <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-400 text-black">
              <Activity size={23} />
            </div>
            <div>
              <h1 className="text-xl font-bold tracking-tight">LifeOS<span className="text-emerald-400">.</span></h1>
              <p className="text-[10px] uppercase tracking-[0.2em] text-zinc-500">Personal operating system</p>
            </div>
          </div>

          <p className="mb-4 text-[10px] font-semibold uppercase tracking-[0.2em] text-zinc-600">
            Workspace
          </p>

          <nav className="space-y-2">
            {navigation.map(({ name, icon: Icon }) => (
              <button
                key={name}
                onClick={() => setActiveTab(name)}
                className={`flex w-full items-center gap-3 rounded-xl px-4 py-3 text-sm transition ${
                  activeTab === name
                    ? 'bg-emerald-400/10 text-emerald-400'
                    : 'text-zinc-500 hover:bg-white/[0.04] hover:text-white'
                }`}
              >
                <Icon size={19} />
                {name}
                {activeTab === name && (
                  <span className="ml-auto h-1.5 w-1.5 rounded-full bg-emerald-400" />
                )}
              </button>
            ))}
          </nav>

          <div className="mt-auto rounded-2xl border border-emerald-400/10 bg-emerald-400/[0.05] p-4">
            <Sparkles size={20} className="mb-3 text-emerald-400" />
            <p className="text-sm font-semibold">Build your future.</p>
            <p className="mt-1 text-xs leading-5 text-zinc-500">
              Small actions. Consistent progress. A better version of yourself.
            </p>
          </div>

          <button className="mt-5 flex items-center gap-3 px-3 py-2 text-sm text-zinc-500">
            <Settings size={18} />
            Settings
          </button>
        </aside>

        {/* Main content */}
        <main className="min-w-0 flex-1 px-5 pb-28 pt-7 sm:px-8 md:px-10 md:pb-10 md:pt-10">

          {/* Header */}
          <header className="mb-9 flex items-center justify-between">
            <div>
              <div className="mb-2 flex items-center gap-2 text-xs text-zinc-500">
                <CalendarDays size={14} />
                {today}
              </div>
              <h2 className="text-2xl font-bold tracking-tight sm:text-3xl">
                Let's make it count<span className="text-emerald-400">.</span>
              </h2>
              <p className="mt-2 text-sm text-zinc-500">
                One day at a time. One goal at a time.
              </p>
            </div>

            <div className="flex h-11 w-11 items-center justify-center rounded-full border border-white/10 bg-[#151916] text-emerald-400">
              <span className="text-sm font-bold">SP</span>
            </div>
          </header>
          {activeTab === 'Fitness' ? (
  <Fitness />
) : (
  <>
          {/* Daily progress */}
          <section className="relative mb-6 overflow-hidden rounded-3xl border border-emerald-400/10 bg-gradient-to-br from-[#14251c] via-[#101b15] to-[#101211] p-6 sm:p-8">
            <div className="pointer-events-none absolute -right-12 -top-20 h-64 w-64 rounded-full bg-emerald-400/[0.07] blur-3xl" />

            <div className="relative flex flex-col justify-between gap-7 sm:flex-row sm:items-center">
              <div>
                <div className="mb-4 flex items-center gap-2 text-xs font-medium text-emerald-400">
                  <Zap size={15} />
                  YOUR DAILY OVERVIEW
                </div>
                <h3 className="text-2xl font-bold sm:text-3xl">
                  Today's progress
                </h3>
                <p className="mt-2 max-w-sm text-sm leading-6 text-zinc-400">
                  Every completed habit is a step towards your goals. Keep moving.
                </p>
                <div className="mt-6 flex items-center gap-3">
                  <span className="text-4xl font-bold tracking-tight">{progress}%</span>
                  <span className="text-xs text-zinc-500">
                    {completed} of {habits.length} habits completed
                  </span>
                </div>
              </div>

              <div className="relative flex h-32 w-32 shrink-0 items-center justify-center self-center rounded-full sm:mr-8">
                <svg viewBox="0 0 120 120" className="h-full w-full -rotate-90">
                  <circle cx="60" cy="60" r="49" fill="none" stroke="#29372e" strokeWidth="8" />
                  <circle
                    cx="60"
                    cy="60"
                    r="49"
                    fill="none"
                    stroke="#4ade80"
                    strokeWidth="8"
                    strokeLinecap="round"
                    strokeDasharray={`${progress * 3.079} 308`}
                  />
                </svg>
                <div className="absolute text-center">
                  <Check className="mx-auto mb-1 text-emerald-400" size={22} />
                  <span className="text-xs text-zinc-400">Keep going</span>
                </div>
              </div>
            </div>
          </section>

          {/* Stats */}
          <section className="mb-8 grid grid-cols-2 gap-3 lg:grid-cols-4">
            <StatCard
              icon={Flame}
              label="Calories"
              value="--"
              detail="Daily target not set"
              color="text-orange-400"
            />
            <StatCard
              icon={Heart}
              label="Protein"
              value="--"
              detail="Start logging meals"
              color="text-pink-400"
            />
            <StatCard
              icon={Droplets}
              label="Water"
              value={`${(water / 1000).toFixed(2)} L`}
              detail={`${waterProgress}% of 3 L target`}
              color="text-sky-400"
            />
            <StatCard
              icon={TrendingUp}
              label="Habits"
              value={`${completed}/${habits.length}`}
              detail="Daily completion"
              color="text-emerald-400"
            />
          </section>

          {/* Main grid */}
          <div className="grid grid-cols-1 gap-5 lg:grid-cols-5">

            {/* Habits */}
            <section className="rounded-2xl border border-white/[0.07] bg-[#111412] p-5 lg:col-span-3">
              <div className="mb-6 flex items-center justify-between">
                <div>
                  <h3 className="font-semibold">Daily habits</h3>
                  <p className="mt-1 text-xs text-zinc-500">Your daily non-negotiables</p>
                </div>
                <span className="rounded-lg bg-emerald-400/10 px-3 py-1.5 text-xs text-emerald-400">
                  {completed}/{habits.length} done
                </span>
              </div>

              <div className="space-y-2">
                {habits.map((habit) => (
                  <button
                    key={habit.id}
                    onClick={() => toggleHabit(habit.id)}
                    className="flex w-full items-center gap-3 rounded-xl border border-transparent p-3 text-left transition hover:border-white/[0.07] hover:bg-white/[0.02]"
                  >
                    <div className={`flex h-5 w-5 shrink-0 items-center justify-center rounded-md border transition ${
                      habit.done
                        ? 'border-emerald-400 bg-emerald-400 text-black'
                        : 'border-zinc-600'
                    }`}>
                      {habit.done && <Check size={13} strokeWidth={3} />}
                    </div>
                    <div className="min-w-0 flex-1">
                      <p className={`text-sm font-medium ${habit.done ? 'text-zinc-500 line-through' : 'text-zinc-200'}`}>
                        {habit.name}
                      </p>
                      <p className="mt-1 text-xs text-zinc-600">{habit.detail}</p>
                    </div>
                    <ChevronRight size={16} className="text-zinc-700" />
                  </button>
                ))}
              </div>
            </section>

            {/* Water */}
            <section className="rounded-2xl border border-white/[0.07] bg-[#111412] p-5 lg:col-span-2">
              <div className="mb-5 flex items-center justify-between">
                <div>
                  <h3 className="font-semibold">Hydration</h3>
                  <p className="mt-1 text-xs text-zinc-500">Stay hydrated throughout the day</p>
                </div>
                <Droplets className="text-sky-400" size={21} />
              </div>

              <div className="mb-5 flex items-end justify-between">
                <div>
                  <p className="text-3xl font-bold">{(water / 1000).toFixed(2)}<span className="text-base text-zinc-500"> L</span></p>
                  <p className="mt-1 text-xs text-zinc-500">of 3.00 L target</p>
                </div>
                <span className="text-sm font-medium text-sky-400">{waterProgress}%</span>
              </div>

              <div className="mb-6 h-2 overflow-hidden rounded-full bg-zinc-800">
                <div
                  className="h-full rounded-full bg-sky-400 transition-all duration-500"
                  style={{ width: `${waterProgress}%` }}
                />
              </div>

              <button
               onClick={() => addWater(250)}
                className="flex w-full items-center justify-center gap-2 rounded-xl bg-sky-400/10 py-3 text-sm font-semibold text-sky-400 transition hover:bg-sky-400/20"
              >
                <Plus size={17} />
                Add 250 ml
              </button>
              <p className="mt-3 text-center text-[10px] text-zinc-600">
                Illustrative starting value. Update with your actual intake.
              </p>
            </section>

            {/* Fitness */}
            <section className="rounded-2xl border border-white/[0.07] bg-[#111412] p-5 lg:col-span-2">
              <div className="mb-5 flex items-center justify-between">
                <h3 className="font-semibold">Fitness</h3>
                <Dumbbell size={20} className="text-emerald-400" />
              </div>
              <div className="rounded-xl bg-[#191e1a] p-4">
                <p className="text-xs text-zinc-500">Today's training</p>
                <p className="mt-2 text-lg font-semibold">Workout not scheduled</p>
                <p className="mt-1 text-xs text-zinc-500">
                  Your training schedule will appear here.
                </p>
                <button
                  onClick={() => setActiveTab('Fitness')}
                  className="mt-4 flex items-center gap-2 text-xs font-semibold text-emerald-400"
                >
                  Explore fitness <ArrowUpRight size={14} />
                </button>
              </div>
            </section>

            {/* Learning */}
            <section className="rounded-2xl border border-white/[0.07] bg-[#111412] p-5 lg:col-span-3">
              <div className="mb-5 flex items-center justify-between">
                <div>
                  <h3 className="font-semibold">Learning & growth</h3>
                  <p className="mt-1 text-xs text-zinc-500">Invest in your future</p>
                </div>
                <Brain size={21} className="text-violet-400" />
              </div>

              <div className="grid gap-3 sm:grid-cols-2">
                <div className="rounded-xl bg-[#19151f] p-4">
                  <div className="mb-3 flex items-center gap-2 text-violet-400">
                    <Shield size={18} />
                    <span className="text-xs font-medium">CYBERSECURITY</span>
                  </div>
                  <p className="font-semibold">Hands-on practice</p>
                  <p className="mt-1 text-xs text-zinc-500">Linux · Networking · DevSecOps</p>
                </div>

                <div className="rounded-xl bg-[#151b21] p-4">
                  <div className="mb-3 flex items-center gap-2 text-sky-400">
                    <BookOpen size={18} />
                    <span className="text-xs font-medium">ACADEMICS</span>
                  </div>
                  <p className="font-semibold">Computer Science</p>
                  <p className="mt-1 text-xs text-zinc-500">CU syllabus · Programming · Revision</p>
                </div>
              </div>
            </section>
          </div>

          <footer className="mt-10 border-t border-white/[0.06] pt-5 text-center text-[11px] text-zinc-600">
            LIFEOS · BUILD YOUR SYSTEM. BUILD YOURSELF.
          </footer>
            </>
)}
        </main>
      </div>

      {/* Mobile bottom navigation */}
      <nav className="fixed inset-x-0 bottom-0 z-50 border-t border-white/[0.08] bg-[#0c0f0d]/95 px-2 pb-safe pt-2 backdrop-blur-xl md:hidden">
        <div className="mx-auto flex max-w-lg justify-around">
          {navigation.map(({ name, icon: Icon }) => (
            <button
              key={name}
              onClick={() => setActiveTab(name)}
              className={`flex min-w-0 flex-col items-center gap-1 px-2 py-2 text-[10px] transition ${
                activeTab === name ? 'text-emerald-400' : 'text-zinc-600'
              }`}
            >
              <Icon size={20} />
              {name}
            </button>
          ))}
        </div>
      </nav>
    </div>
  )
}

function StatCard({
  icon: Icon,
  label,
  value,
  detail,
  color,
}: {
  icon: typeof Activity
  label: string
  value: string
  detail: string
  color: string
}) {
  return (
    <div className="rounded-2xl border border-white/[0.07] bg-[#111412] p-4">
      <div className="mb-4 flex items-center justify-between">
        <span className="text-xs text-zinc-500">{label}</span>
        <Icon size={18} className={color} />
      </div>
      <p className="text-2xl font-bold tracking-tight">{value}</p>
      <p className="mt-1 text-[10px] text-zinc-600">{detail}</p>
    </div>
  )
}

export default App
